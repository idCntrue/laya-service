# ---------------------------------------------------------------------------
# Laya Service configuration
#
# Copy to `.env` and edit. Every value here is read by
# `laya_service.infrastructure.config.settings.Settings`. Nothing is hard-coded
# in the source.
# ---------------------------------------------------------------------------

# Compute backend passed to Laya: auto | cpu | cuda | mlx
# `auto` lets Laya choose. On x86_64 servers without a GPU this resolves to cpu.
LAYA_BACKEND=auto

# Model identifier. Leave empty to use Laya's default model.
LAYA_MODEL=

# Hugging Face endpoint. The mirror is dramatically faster from mainland China
# and harmless elsewhere. Set to https://huggingface.co if you need the origin.
#
# NOTE: the mirror does not proxy the Xet CAS transfer protocol, so
# HF_HUB_DISABLE_XET=1 below is required with it. Without that you get:
#   "CAS Client Error: HTTP status client error (401 Unauthorized),
#    domain: https://cas-server.xethub.hf.co/..."
HF_ENDPOINT=https://hf-mirror.com

# Disable the Xet transfer protocol and fall back to plain HTTP range requests.
# Required when HF_ENDPOINT is a mirror that does not proxy Xet (see above).
# Remove this line if you use the origin and want Xet's faster transfers.
HF_HUB_DISABLE_XET=1

# Interface and port to bind.
# NOTE: binding anything other than 127.0.0.1/localhost/::1 REQUIRES LAYA_API_KEY
# to be set, or the service refuses to start. This is deliberate.
HOST=0.0.0.0
PORT=9800

# Shared secret required as `Authorization: Bearer <key>` on every /v1/* route.
# Leave empty ONLY when HOST is a loopback address. Generate one with:
#   python3 -c "import secrets; print(secrets.token_urlsafe(32))"
LAYA_API_KEY=

# Minimum log level: DEBUG | INFO | WARNING | ERROR | CRITICAL
LOG_LEVEL=INFO

# Comma-separated CORS allow-list, e.g. https://console.example.com,https://ops.example.com
# Leave empty to disable CORS entirely (correct for a server-to-server API).
CORS_ORIGINS=

# Maximum accepted request body size, in bytes. 65536 = 64 KiB.
MAX_BODY_BYTES=65536

# Load model weights during startup instead of on the first request.
# true  -> startup takes minutes on a cold cache, but /readyz is meaningful at once.
# false -> startup is instant; /readyz returns 503 until the first request warms it.
PRELOAD_MODEL=false

# Override where model weights are cached. Empty uses the Hugging Face default
# (~/.cache/huggingface). Point this at a persistent volume in production so a
# container restart does not re-download gigabytes.
MODEL_CACHE_DIR=

# Per-request inference budget, in seconds.
REQUEST_TIMEOUT_S=120

# ---------------------------------------------------------------------------
# systemd only (see deploy/systemd/laya-service.service)
#
# A *user* systemd manager inside a container cannot obtain CAP_SETPCAP or
# CAP_SYS_ADMIN, so these three hardening directives fail independently with
# "status=218/CAPABILITIES" and the unit will not spawn. Set them to false on
# such a host. They are ON by default in the unit, which is correct on a normal
# host -- only disable them if the unit actually refuses to start.
# ---------------------------------------------------------------------------
# SYSTEMD_NO_NEW_PRIVILEGES=false
# SYSTEMD_PRIVATE_DEVICES=false
# SYSTEMD_PROTECT_KERNEL_MODULES=false

# ---------------------------------------------------------------------------
# Compatibility layer (OpenAI / Anthropic)
#
# Lets an unmodified official SDK point its base_url here and use TOOL CALLING.
# Chat is not supported and is rejected with 400 -- the model classifies, it
# does not generate text. See API.md for the mapping rules.
# ---------------------------------------------------------------------------

# Serve /v1/chat/completions, /v1/messages and /v1/models.
COMPAT_ENABLED=true

# Comma-separated model ids the compat endpoints advertise and accept.
# Only 'english' is served by default: 'multilingual' needs another 322 MB of
# weights and ~1.5 GB resident, and 'typed-decisions' is fine-tuned on four
# specific question-id sets, so an arbitrary schema is out of distribution.
COMPAT_MODELS=english

# Location of the API key file backing /admin/keys. Holds sha256 hashes, never
# plaintext. Created 0600 on first use. Keep it off any shared volume.
API_KEYS_PATH=data/api_keys.json
